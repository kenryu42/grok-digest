{
  "name": "grok-digest-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter grok-digest build && pnpm --filter grok-digest-starter build",
    "dev": "pnpm --filter grok-digest build && pnpm --filter grok-digest-starter dev",
    "test": "pnpm --filter grok-digest test",
    "check": "pnpm --filter grok-digest build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm lint:comments && pnpm lint:dup && pnpm knip && pnpm test && pnpm check:starter",
    "check:starter": "node scripts/check-starter.mjs && node scripts/check-starter.mjs --packed",
    "typecheck": "pnpm --filter grok-digest typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:comments": "node scripts/lint-comments.mjs",
    "lint:dup": "jscpd --threshold 0 --exit-code 1 --no-tips --reporters ai --ignore '**/pnpm-lock.yaml,**/data/*.json,**/test/fixtures/**,**/dist/**,**/.github/workflows/**' .",
    "knip": "knip",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.2",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "oxc-parser": "0.154.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.4"
}
