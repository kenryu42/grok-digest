{
  "name": "grok-digest",
  "version": "0.1.0",
  "description": "Astro integration that renders a Grok Digest site: X bookmarks summarized by Grok, searchable, sorted by topic, with RSS feeds.",
  "keywords": [
    "astro",
    "astro-integration",
    "bookmarks",
    "grok",
    "rss",
    "x"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenryu42/grok-digest.git"
  },
  "bin": {
    "grok-digest": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "bun run build && mkdir -p template/node_modules && ln -sfn ../.. template/node_modules/grok-digest && cd template && node node_modules/grok-digest/dist/cli.js dev",
    "test": "vitest run",
    "typecheck": "astro sync && tsc --noEmit && astro check",
    "check": "bun run build && bun run typecheck && bun run lint && bun run format:check && bun run lint:comments && bun run lint:dup && bun run knip && bun run test && bun run check:starter",
    "check:starter": "node scripts/check-starter.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:comments": "node scripts/lint-comments.mjs",
    "lint:dup": "jscpd --threshold 0 --exit-code 1 --no-tips --reporters ai --ignore '**/bun.lock,**/data/*.json,**/test/fixtures/**,**/dist/**,**/.github/workflows/**' .",
    "knip": "knip",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler-rs": "0.5.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "oxc-parser": "0.154.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.3"
}
