{
  "name": "x-bookmarks",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "check": "astro sync && pnpm typecheck && pnpm lint && pnpm format:check && pnpm lint:comments && pnpm lint:dup && pnpm knip && pnpm test",
    "typecheck": "tsc --noEmit && astro check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:comments": "node scripts/lint-comments.mjs",
    "lint:dup": "jscpd --threshold 0 --exit-code 1 --no-tips --reporters ai --ignore pnpm-lock.yaml,data/bookmarks.json .",
    "knip": "knip",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler-rs": "0.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "oxc-parser": "0.154.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.4"
}
