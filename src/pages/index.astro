---
import BookmarkCard from "virtual:grok-digest/components/BookmarkCard.astro";
import Footer from "virtual:grok-digest/components/Footer.astro";
import Header from "virtual:grok-digest/components/Header.astro";
import { BookmarkControls } from "../components/BookmarkControls";
import Layout from "../layouts/Layout.astro";
import { bookmarks } from "../lib/load-bookmarks";
import { siteHref } from "../lib/paths";
import { toSearchEntry } from "../lib/search";
import { siteConfig } from "../lib/site-config";

const entries = bookmarks.map(toSearchEntry);
const { title, swipeMode } = siteConfig;
---

<Layout title={title} description="Posts saved from X, summarized and sorted by topic." feedHref={siteHref("rss.xml")}>
  <div class="mx-auto flex min-h-dvh max-w-2xl flex-col px-safe-4 sm:px-safe-6">
    <Header title={title} swipeMode={swipeMode} />

    <noscript>
      <style is:inline>
        [data-bookmark-list] {
          visibility: visible !important;
        }
      </style>
    </noscript>

    <main class="flex flex-1 flex-col gap-6 pb-16">
      {bookmarks.length > 0 ? (
        <>
          <BookmarkControls client:only="react" entries={entries} settings={{ swipeMode }} />
          <ul data-bookmark-list class="flex flex-col gap-4 not-data-ready:invisible sm:gap-5">
            {bookmarks.map((bookmark) => (
              <BookmarkCard bookmark={bookmark} />
            ))}
          </ul>
        </>
      ) : (
        <p class="font-serif text-lg text-muted-foreground">No bookmarks yet. Share a post on X by email to add one.</p>
      )}
    </main>

    <Footer />
  </div>
</Layout>
