---
import Mascot from "../assets/mascot.svg";
import BookmarkCard from "../components/BookmarkCard.astro";
import { BookmarkControls } from "../components/BookmarkControls";
import { ThemeToggle } from "../components/ThemeToggle";
import Layout from "../layouts/Layout.astro";
import { bookmarks } from "../lib/load-bookmarks";
import { toSearchEntry } from "../lib/search";

const entries = bookmarks.map(toSearchEntry);
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const feedHref = `${base}rss.xml`;
const designFeedHref = `${base}rss/design.xml`;
---

<Layout title="Grok Digest" description="Posts saved from X, summarized and sorted by topic." feedHref={feedHref}>
  <div class="mx-auto flex min-h-dvh max-w-2xl flex-col px-safe-4 max-sm:pb-[calc(env(safe-area-inset-bottom)+--spacing(18))] sm:px-safe-6">
    <header class="flex items-start justify-between gap-4 pt-safe-6 pb-4 sm:pt-safe-16 sm:pb-8">
      <div class="flex flex-col gap-2 sm:gap-3">
        <Mascot aria-hidden="true" class="h-12 w-15 sm:h-16 sm:w-20" />
        <h1 class="font-heading text-lg font-semibold tracking-tight sm:text-xl">Grok Digest</h1>
      </div>
      <ThemeToggle client:load />
    </header>

    <noscript>
      <style is:inline>
        [data-bookmark-list] {
          visibility: visible !important;
        }
      </style>
    </noscript>

    <main class="flex flex-1 flex-col gap-6 pb-16">
      {bookmarks.length > 0 ? (
        <>
          <BookmarkControls client:only="react" entries={entries} />
          <ul data-bookmark-list class="flex flex-col gap-4 not-data-ready:invisible sm:gap-5">
            {bookmarks.map((bookmark) => (
              <BookmarkCard bookmark={bookmark} />
            ))}
          </ul>
        </>
      ) : (
        <p class="font-serif text-lg text-muted-foreground">No bookmarks yet. Share a post on X by email to add one.</p>
      )}
    </main>

    <footer class="flex flex-col gap-2 border-t pt-8 pb-safe-8 text-sm text-muted-foreground">
      <p>
        <a class="underline decoration-border underline-offset-4 hover:decoration-brand" href={feedHref}>
          Follow new bookmarks
        </a>{" "}
        in a feed reader. Each topic has its own feed, such as{" "}
        <a class="underline decoration-border underline-offset-4 hover:decoration-brand" href={designFeedHref}>
          Design
        </a>
        .
      </p>
      <p>This page is unlisted, not private. Anyone with the link can see it.</p>
      <p class="text-xs">Unofficial. Summaries created with Grok.</p>
    </footer>
  </div>
</Layout>
