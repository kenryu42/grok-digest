---
import Mascot from "../assets/mascot.svg";
import { TextSizeControl } from "./TextSizeControl";
import { ThemeToggle } from "./ThemeToggle";

type Props = {
  title: string;
};

const { title } = Astro.props;
---

<header class="flex items-start justify-between gap-4 pt-safe-6 pb-4 sm:pt-safe-16 sm:pb-8">
  <div class="flex flex-col gap-2 sm:gap-3">
    <Mascot aria-hidden="true" class="h-9 w-11.25 sm:h-11 sm:w-13.75" />
    <h1 class="font-heading text-lg font-semibold tracking-tight sm:text-xl">{title}</h1>
  </div>
  <div class="flex items-center gap-1">
    <TextSizeControl client:load />
    <ThemeToggle client:load />
  </div>
</header>
