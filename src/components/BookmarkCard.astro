---
import { ArrowUpRightIcon, CheckIcon, ChevronDownIcon, CopyIcon, LinkIcon, ZapIcon } from "lucide-react";
import { Badge } from "./ui/badge";
import { Button } from "./ui/button";
import { Card } from "./ui/card";
import type { Bookmark } from "../lib/bookmarks";
import { copyText } from "../lib/copy";
import { imagesWithAlt } from "../lib/media";
import { TOPIC_LABELS } from "../lib/topics";

type Props = {
  bookmark: Bookmark;
};

const { bookmark } = Astro.props;
const { id, url, author, postedAt, savedAt, topic, shelfLife, tldr, summary, text, keyPoints, action, links } =
  bookmark;

const dateFormat = new Intl.DateTimeFormat("en", { dateStyle: "medium", timeZone: "UTC" });
const isoDay = (date: Date) => date.toISOString().slice(0, 10);
const postedOtherDay = isoDay(postedAt) !== isoDay(savedAt);
const hostOf = (link: string) => new URL(link).hostname.replace(/^www\./, "");
const images = imagesWithAlt(bookmark);
---

<li id={`b-${id}`} data-bookmark-id={id} data-url={url} data-topic={topic} class="group/bookmark scroll-mt-6">
  <Card className="relative gap-0 py-0 shadow-xs before:absolute before:inset-y-0 before:left-0 before:w-1 before:bg-topic before:transition-opacity group-data-[done]/bookmark:before:opacity-55 ring-foreground/8 [--card-spacing:--spacing(5)] has-[summary:focus-visible]:ring-2 has-[summary:focus-visible]:ring-ring sm:[--card-spacing:--spacing(6)]">
    <details open class="group/details transition-opacity group-data-[done]/bookmark:opacity-55">
      <summary class="flex cursor-pointer list-none flex-col gap-2 px-(--card-spacing) pt-(--card-spacing) pb-4 outline-none [&::-webkit-details-marker]:hidden">
        <span class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 text-sm">
          <span class="flex min-w-0 flex-wrap items-baseline gap-x-1.5">
            <span class="font-medium text-foreground">{author.name}</span>
            <span class="text-muted-foreground">@{author.handle}</span>
          </span>
          <span class="shrink-0 text-xs text-muted-foreground tabular-nums">
            Saved <time datetime={savedAt.toISOString()}>{dateFormat.format(savedAt)}</time>
            {postedOtherDay && (
              <>
                {" · "}Posted <time datetime={isoDay(postedAt)}>{dateFormat.format(postedAt)}</time>
              </>
            )}
          </span>
        </span>
        <span data-review-reason class="text-xs font-medium tracking-wide text-brand-ink uppercase" hidden></span>
        <span class="flex items-start justify-between gap-3">
          <h2 class="font-heading text-xl leading-snug font-semibold text-balance text-foreground sm:text-[1.375rem]">
            {tldr}
          </h2>
          <ChevronDownIcon
            className="mt-1.5 size-4 shrink-0 text-muted-foreground transition-transform group-open/details:rotate-180"
            aria-hidden="true"
          />
        </span>
        {action !== "" && (
          <span class="flex items-start gap-2 rounded-lg bg-brand-soft px-3 py-2 text-sm leading-relaxed text-foreground">
            <ZapIcon className="mt-1 size-3.5 shrink-0 fill-brand text-brand-ink" aria-hidden="true" />
            <span class="text-pretty">
              <span class="font-medium text-brand-ink">Try:</span> {action}
            </span>
          </span>
        )}
      </summary>

      <div class="flex flex-col gap-4 px-(--card-spacing) pb-4">
        <p class="font-serif text-[1.0625rem] leading-relaxed text-pretty text-foreground/90">{summary}</p>
        {keyPoints.length > 0 && (
          <ul class="flex flex-col gap-2 border-l-2 border-border pl-4 text-[0.9375rem] leading-relaxed text-foreground/85">
            {keyPoints.map((point) => (
              <li class="text-pretty">{point}</li>
            ))}
          </ul>
        )}
        {links.length > 0 && (
          <ul class="flex flex-col gap-1.5 text-sm" aria-label="Links in the post">
            {links.map((link) => (
              <li>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/link inline-flex items-baseline gap-2 rounded-sm focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
                >
                  <LinkIcon className="size-3.5 shrink-0 translate-y-0.5 text-muted-foreground" aria-hidden="true" />
                  <span class="text-pretty text-foreground underline decoration-border underline-offset-4 transition-colors group-hover/link:decoration-brand">
                    {link.title}
                  </span>
                  <span class="shrink-0 text-xs text-muted-foreground">{hostOf(link.url)}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
        {(text !== "" || images.length > 0) && (
          <figure class="border-t border-border pt-4">
            <figcaption class="mb-2 text-xs font-medium text-muted-foreground">Original post</figcaption>
            {text !== "" && (
              <blockquote class="text-sm leading-relaxed whitespace-pre-wrap text-pretty text-foreground/80">
                {text}
              </blockquote>
            )}
            {images.length > 0 && (
              <ul
                class:list={["grid max-w-md gap-2", { "grid-cols-2": images.length > 1, "mt-3": text !== "" }]}
                aria-label="Images in the post"
              >
                {images.map((image, index) => (
                  <li class:list={{ "col-span-2": index === 0 && images.length > 1 && images.length % 2 === 1 }}>
                    <a
                      href={image.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="block overflow-hidden rounded-lg border border-border bg-muted focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
                    >
                      <img
                        src={image.url}
                        alt={image.alt}
                        loading="lazy"
                        decoding="async"
                        class="aspect-video w-full object-cover"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </figure>
        )}
      </div>
    </details>

    <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2 px-(--card-spacing) pb-(--card-spacing)">
      <div class="flex flex-wrap items-center gap-1.5">
        <Badge className="bg-topic-soft text-topic">{TOPIC_LABELS[topic]}</Badge>
        {shelfLife === "news" && (
          <Badge variant="outline" className="border-brand/60 text-brand-ink">
            News
          </Badge>
        )}
      </div>
      <div class="ml-auto flex items-center gap-3">
        <Button
          type="button"
          variant="ghost"
          size="sm"
          data-copy={copyText(bookmark)}
          title="Copy for an AI assistant (c)"
          className="rounded-full"
        >
          <CopyIcon className="group-data-[copied]/button:hidden" aria-hidden="true" />
          <CheckIcon className="hidden group-data-[copied]/button:block" aria-hidden="true" />
          <span data-copy-label aria-live="polite">
            Copy
          </span>
        </Button>
        <Button
          type="button"
          variant="outline"
          size="sm"
          data-done-toggle
          aria-pressed="false"
          title="Mark done (e)"
          className="rounded-full aria-pressed:border-done aria-pressed:bg-done aria-pressed:text-done-foreground aria-pressed:hover:bg-done/85 aria-pressed:hover:text-done-foreground dark:aria-pressed:border-done dark:aria-pressed:bg-done dark:aria-pressed:hover:bg-done/85"
        >
          <CheckIcon aria-hidden="true" />
          Done
        </Button>
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 rounded-sm text-sm font-medium whitespace-nowrap text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-brand focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
        >
          Open on X<ArrowUpRightIcon className="size-3.5" aria-hidden="true" />
        </a>
      </div>
    </div>
  </Card>
</li>
