---
import { ArrowUpRightIcon, CheckIcon, ChevronDownIcon, CopyIcon, InboxIcon, LinkIcon, ZapIcon } from "lucide-react";
import { Badge } from "./ui/badge";
import { Button } from "./ui/button";
import { Card } from "./ui/card";
import type { Bookmark } from "../lib/bookmarks";
import { copyText } from "../lib/copy";
import { postParts } from "../lib/media";
import { TOPIC_LABELS } from "../lib/topics";

type Props = {
  bookmark: Bookmark;
};

const { bookmark } = Astro.props;
const { id, url, author, postedAt, savedAt, topic, shelfLife, tldr, summary, keyPoints, action, links } = bookmark;

const dateFormat = new Intl.DateTimeFormat("en", { dateStyle: "medium", timeZone: "UTC" });
const isoDay = (date: Date) => date.toISOString().slice(0, 10);
const postedOtherDay = isoDay(postedAt) !== isoDay(savedAt);
const hostOf = (link: string) => new URL(link).hostname.replace(/^www\./, "");
const post = postParts(bookmark);
const posted = dateFormat.format(postedAt);
---

<li
  id={`b-${id}`}
  data-bookmark-id={id}
  data-url={url}
  data-topic={topic}
  data-depth="full"
  class="group/bookmark relative touch-pan-y touch-pinch-zoom scroll-mt-6 transition-[scale] duration-500 ease-spring data-pressed:scale-[0.98] data-pressed:duration-150 max-sm:scroll-mt-[calc(var(--controls-height,0px)+--spacing(3))]"
>
  <span
    aria-hidden="true"
    class="absolute inset-0 hidden items-center justify-end gap-1.5 rounded-xl bg-done px-6 text-sm font-medium text-done-foreground group-data-[done]/bookmark:bg-muted group-data-[done]/bookmark:text-foreground group-data-[swiped]/bookmark:flex group-data-[swiping]/bookmark:flex"
  >
    <CheckIcon className="size-4 group-data-[done]/bookmark:hidden" />
    <span class="group-data-[done]/bookmark:hidden">Done</span>
    <InboxIcon className="hidden size-4 group-data-[done]/bookmark:block" />
    <span class="hidden group-data-[done]/bookmark:inline">Back to inbox</span>
  </span>
  <Card
    data-swipe-surface
    className="relative gap-0 py-0 shadow-xs before:absolute before:inset-y-0 before:left-0 before:w-1 before:bg-topic before:transition-opacity group-data-[done]/bookmark:before:opacity-55 ring-foreground/8 [--card-spacing:--spacing(5)] has-[[data-card-toggle]:focus-visible]:ring-2 has-[[data-card-toggle]:focus-visible]:ring-ring sm:[--card-spacing:--spacing(6)]"
  >
    <div class="flex flex-col transition-opacity group-data-[depth=gist]/bookmark:pb-1 group-data-[depth=headline]/bookmark:pb-1 group-data-[done]/bookmark:opacity-55">
      <div data-card-head class="flex cursor-pointer flex-col gap-2 px-(--card-spacing) pt-(--card-spacing) pb-4">
        <span class="flex items-baseline justify-between gap-3 text-sm">
          <span class="flex min-w-0 items-baseline gap-x-1.5">
            <span data-author class="min-w-0 truncate font-medium text-foreground">
              {author.name}
            </span>
            <span class="min-w-0 shrink-[3] truncate text-muted-foreground">@{author.handle}</span>
          </span>
          <span class="shrink-0 text-xs text-muted-foreground tabular-nums">
            <span class="max-sm:hidden">Saved </span>
            <time datetime={savedAt.toISOString()}>{dateFormat.format(savedAt)}</time>
            {postedOtherDay && (
              <span class="max-sm:hidden">
                {" · "}Posted <time datetime={isoDay(postedAt)}>{posted}</time>
              </span>
            )}
          </span>
        </span>
        <span data-review-reason class="text-xs font-medium tracking-wide text-brand-ink uppercase" hidden></span>
        <span class="flex items-start justify-between gap-3">
          <h2 class="min-w-0 flex-1 font-heading text-xl leading-snug font-semibold text-balance text-foreground sm:text-headline">
            <button
              type="button"
              data-card-toggle
              aria-expanded="true"
              class="block w-full cursor-pointer text-left text-balance outline-none"
            >
              {tldr}
            </button>
          </h2>
          <ChevronDownIcon
            className="mt-1.5 size-4 shrink-0 text-muted-foreground transition-transform duration-500 ease-spring group-has-[[data-card-toggle][aria-expanded=true]]/bookmark:rotate-180"
            aria-hidden="true"
          />
        </span>
      </div>

      <p
        data-level="gist"
        data-read-summary
        class="px-(--card-spacing) pb-4 font-serif text-summary leading-relaxed text-pretty text-foreground/90"
      >
        {summary}
      </p>

      {(keyPoints.length > 0 || action !== "") && (
        <div data-level="points" class="flex flex-col gap-4 px-(--card-spacing) pb-4">
          {keyPoints.length > 0 && (
            <ul class="flex flex-col gap-2 border-l-2 border-border pl-4 text-point leading-relaxed text-foreground/85">
              {keyPoints.map((point) => (
                <li data-read-point class="text-pretty">
                  {point}
                </li>
              ))}
            </ul>
          )}
          {action !== "" && (
            <p class="flex items-start gap-2 rounded-lg bg-brand-soft px-3 py-2 text-sm leading-relaxed text-foreground">
              <ZapIcon className="mt-1 size-3.5 shrink-0 fill-brand text-brand-ink" aria-hidden="true" />
              <span class="text-pretty">
                <span class="font-medium text-brand-ink">Try:</span> <span data-read-action>{action}</span>
              </span>
            </p>
          )}
        </div>
      )}

      <div data-level="full" class="flex flex-col gap-4 px-(--card-spacing) pb-4">
        {links.length > 0 && (
          <ul class="flex flex-col gap-1.5 text-sm" aria-label="Links in the post">
            {links.map((link) => (
              <li>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/link inline-flex items-baseline gap-2 rounded-sm focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
                >
                  <LinkIcon className="size-3.5 shrink-0 translate-y-0.5 text-muted-foreground" aria-hidden="true" />
                  <span class="text-pretty text-foreground underline decoration-border underline-offset-4 transition-colors group-hover/link:decoration-brand">
                    {link.title}
                  </span>
                  <span class="shrink-0 text-xs text-muted-foreground">{hostOf(link.url)}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
        {post.length > 0 && (
          <figure class="border-t border-border pt-4">
            <figcaption class="mb-2 text-xs font-medium text-muted-foreground">Original post</figcaption>
            <blockquote class="flex flex-col gap-3 text-sm leading-relaxed text-pretty text-foreground/80">
              {post.map((part) =>
                part.kind === "text" ? (
                  <p data-read-post class="whitespace-pre-wrap">
                    {part.text}
                  </p>
                ) : (
                  <ul
                    class:list={["grid max-w-md gap-2", { "grid-cols-2": part.images.length > 1 }]}
                    aria-label="Images in the post"
                  >
                    {part.images.map((image, index) => (
                      <li
                        class:list={{
                          "col-span-2": index === 0 && part.images.length > 1 && part.images.length % 2 === 1,
                        }}
                      >
                        <a
                          href={image.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="block overflow-hidden rounded-lg border border-border bg-muted focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
                        >
                          <img
                            src={image.url}
                            alt={image.alt}
                            loading="lazy"
                            decoding="async"
                            class:list={[
                              "w-full",
                              part.images.length === 1
                                ? "max-h-[32rem] min-h-24 object-contain"
                                : "aspect-video object-cover",
                            ]}
                          />
                        </a>
                      </li>
                    ))}
                  </ul>
                ),
              )}
            </blockquote>
          </figure>
        )}
        {postedOtherDay && (
          <p class="text-xs text-muted-foreground tabular-nums sm:hidden">
            Posted <time datetime={isoDay(postedAt)}>{posted}</time>
          </p>
        )}
      </div>
    </div>

    <div
      data-level="points"
      class="flex flex-col gap-3 px-(--card-spacing) pb-(--card-spacing) sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-x-3 sm:gap-y-2"
    >
      <div class="flex flex-wrap items-center gap-1.5">
        <Badge className="bg-topic-soft text-topic">{TOPIC_LABELS[topic]}</Badge>
        {shelfLife === "news" && (
          <Badge variant="outline" className="border-brand/60 text-brand-ink">
            News
          </Badge>
        )}
      </div>
      <div class="grid grid-cols-3 gap-2 sm:ml-auto sm:flex sm:items-center sm:gap-3">
        <Button
          type="button"
          variant="ghost"
          size="sm"
          data-copy={copyText(bookmark)}
          title="Copy for an AI assistant (c)"
          className="rounded-full max-sm:h-10"
        >
          <CopyIcon className="group-data-[copied]/button:hidden" aria-hidden="true" />
          <CheckIcon className="hidden group-data-[copied]/button:block" aria-hidden="true" />
          <span data-copy-label aria-live="polite">
            Copy
          </span>
        </Button>
        <Button
          type="button"
          variant="outline"
          size="sm"
          data-done-toggle
          aria-pressed="false"
          title="Mark done (e)"
          className="rounded-full max-sm:h-10 aria-pressed:border-done aria-pressed:bg-done aria-pressed:text-done-foreground aria-pressed:hover:bg-done/85 aria-pressed:hover:text-done-foreground dark:aria-pressed:border-done dark:aria-pressed:bg-done dark:aria-pressed:hover:bg-done/85"
        >
          <CheckIcon aria-hidden="true" />
          Done
        </Button>
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-1 rounded-sm text-sm max-sm:h-10 max-sm:rounded-full font-medium whitespace-nowrap text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-brand focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
        >
          Open on X<ArrowUpRightIcon className="size-3.5" aria-hidden="true" />
        </a>
      </div>
    </div>
  </Card>
</li>
