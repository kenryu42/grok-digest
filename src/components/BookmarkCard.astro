---
import {
  ArrowUpRightIcon,
  CheckIcon,
  ChevronDownIcon,
  ClockIcon,
  CopyIcon,
  ImagesIcon,
  InboxIcon,
  ZapIcon,
} from "lucide-react";
import { Button } from "./ui/button";
import { Card } from "./ui/card";
import { LinkCard } from "./LinkCard";
import { PostBody } from "./PostBody";
import { TopicTile } from "./TopicTile";
import type { Bookmark } from "../lib/bookmarks";
import { cardKind } from "../lib/card-kind";
import { copyText } from "../lib/copy";
import { listedLinks, postParts } from "../lib/media";
import { TOPIC_LABELS } from "../lib/topics";

type Props = {
  bookmark: Bookmark;
};

const { bookmark } = Astro.props;
const { id, url, author, postedAt, savedAt, topic, shelfLife, tldr, summary, keyPoints, action, links } = bookmark;

const dateFormat = new Intl.DateTimeFormat("en", { dateStyle: "medium", timeZone: "UTC" });
const isoDay = (date: Date) => date.toISOString().slice(0, 10);
const postedOtherDay = isoDay(postedAt) !== isoDay(savedAt);
const post = postParts(bookmark);
const listed = listedLinks(links);
const posted = dateFormat.format(postedAt);
const visual = cardKind(bookmark);
---

<li
  id={`b-${id}`}
  data-bookmark-id={id}
  data-url={url}
  data-topic={topic}
  data-depth="full"
  class="group/bookmark relative touch-pan-y touch-pinch-zoom scroll-mt-6 max-sm:scroll-mt-[calc(var(--controls-height,0px)+--spacing(3))]"
>
  <div
    data-swipe-actions
    class="invisible absolute top-0 right-0 flex h-full items-center gap-4 px-4 group-data-[actions]/bookmark:visible group-data-[swiped]/bookmark:visible group-data-[swiping]/bookmark:visible"
  >
    <button
      type="button"
      data-swipe-action="later"
      class="flex flex-col items-center gap-1.5 text-xs font-medium text-muted-foreground outline-none"
    >
      <span class="flex size-12 items-center justify-center rounded-full bg-brand text-black shadow-sm">
        <ClockIcon className="size-5" aria-hidden="true" />
      </span>
      Later
    </button>
    <button
      type="button"
      data-swipe-action="done"
      class="flex flex-col items-center gap-1.5 text-xs font-medium text-muted-foreground outline-none"
    >
      <span class="flex size-12 items-center justify-center rounded-full bg-done text-done-foreground shadow-sm group-data-[done]/bookmark:bg-muted-foreground group-data-[done]/bookmark:text-background">
        <CheckIcon className="size-5 group-data-[done]/bookmark:hidden" aria-hidden="true" />
        <InboxIcon className="hidden size-5 group-data-[done]/bookmark:block" aria-hidden="true" />
      </span>
      <span class="group-data-[done]/bookmark:hidden">Done</span>
      <span class="hidden group-data-[done]/bookmark:inline">Inbox</span>
    </button>
  </div>
  <Card
    data-swipe-surface
    className="relative gap-0 py-0 shadow-xs ring-foreground/8 [--card-spacing:--spacing(5)] has-[[data-card-toggle]:focus-visible]:ring-2 has-[[data-card-toggle]:focus-visible]:ring-ring sm:[--card-spacing:--spacing(6)]"
  >
    <div class="flex flex-col transition-opacity group-data-[depth=gist]/bookmark:pb-1 group-data-[depth=headline]/bookmark:pb-1 group-data-[done]/bookmark:opacity-55">
      <div data-card-head class="flex cursor-pointer flex-col gap-2 px-(--card-spacing) pt-(--card-spacing) pb-4">
        {visual.kind === "photo" && (
          <div
            data-cover
            class="relative mb-2 aspect-video overflow-hidden rounded-xl after:pointer-events-none after:absolute after:inset-0 after:rounded-[inherit] after:inset-ring after:inset-ring-foreground/10 group-data-[depth=full]/bookmark:hidden group-data-[depth=headline]/bookmark:aspect-[5/2] sm:aspect-[2.4/1] sm:group-data-[depth=headline]/bookmark:aspect-[4/1]"
          >
            <TopicTile topic={topic} seed={id} className="absolute inset-0" />
            <img
              src={visual.image.url}
              alt={visual.image.alt}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 size-full object-cover"
            />
            {visual.count > 1 && (
              <span class="absolute right-3 bottom-3 inline-flex items-center gap-1 rounded-full bg-black/60 px-2 py-0.5 text-xs font-medium text-white tabular-nums backdrop-blur-sm">
                <ImagesIcon className="size-3.5" aria-hidden="true" />
                {visual.count}
              </span>
            )}
          </div>
        )}
        <span class="flex items-center justify-between gap-3">
          <span class="flex min-w-0 items-center gap-1.5 text-xs font-semibold tracking-wider uppercase">
            <span class="shrink-0 text-topic">{TOPIC_LABELS[topic]}</span>
            {visual.kind === "link" && (
              <>
                <span aria-hidden="true" class="text-muted-foreground/60 max-sm:hidden">
                  ·
                </span>
                <span class="min-w-0 truncate font-medium tracking-normal text-muted-foreground normal-case max-sm:hidden">
                  {visual.host}
                </span>
              </>
            )}
            {shelfLife === "news" && (
              <>
                <span aria-hidden="true" class="text-muted-foreground/60">
                  ·
                </span>
                <span class="shrink-0 text-brand-ink">News</span>
              </>
            )}
          </span>
          <span class="flex shrink-0 items-center gap-2 text-xs text-muted-foreground tabular-nums">
            <span>
              <span class="max-sm:hidden">Saved </span>
              <time datetime={savedAt.toISOString()}>{dateFormat.format(savedAt)}</time>
              {postedOtherDay && (
                <span class="max-sm:hidden">
                  {" · "}Posted <time datetime={isoDay(postedAt)}>{posted}</time>
                </span>
              )}
            </span>
            <ChevronDownIcon
              className="size-4 transition-transform duration-500 ease-spring group-has-[[data-card-toggle][aria-expanded=true]]/bookmark:rotate-180"
              aria-hidden="true"
            />
          </span>
        </span>
        <span data-review-reason class="text-xs font-medium tracking-wide text-brand-ink uppercase" hidden></span>
        <span class="flex items-start gap-4">
          <span class="flex min-w-0 flex-1 flex-col gap-2">
            <h2 class="min-w-0 flex-1 font-heading text-xl leading-snug font-semibold text-balance text-foreground sm:text-headline">
              <button
                type="button"
                data-card-toggle
                aria-expanded="true"
                class="block w-full cursor-pointer text-left text-balance outline-none"
              >
                {tldr}
              </button>
            </h2>
            <span class="flex min-w-0 items-baseline gap-x-1.5 text-sm">
              <span data-author class="min-w-0 truncate font-medium text-foreground">
                {author.name}
              </span>
              <span class="min-w-0 shrink-[3] truncate text-muted-foreground">@{author.handle}</span>
            </span>
          </span>
          {visual.kind !== "photo" && (
            <span
              data-cover
              class:list={[
                "relative mt-1 size-16 shrink-0 overflow-hidden rounded-lg shadow-xs sm:size-20",
                { "group-data-[depth=full]/bookmark:hidden": visual.kind === "link" && visual.image !== undefined },
              ]}
            >
              <TopicTile
                topic={topic}
                seed={id}
                letter={visual.kind === "link" ? visual.host.charAt(0).toUpperCase() : undefined}
                className="absolute inset-0"
              />
              {visual.kind === "link" && visual.image !== undefined && (
                <img
                  src={visual.image}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 size-full object-cover"
                />
              )}
            </span>
          )}
        </span>
      </div>

      <p
        data-level="gist"
        data-read-summary
        class="px-(--card-spacing) pb-4 font-serif text-summary leading-relaxed text-pretty text-foreground/90"
      >
        {summary}
      </p>

      {(keyPoints.length > 0 || action !== "") && (
        <div data-level="points" class="flex flex-col gap-4 px-(--card-spacing) pb-4">
          {keyPoints.length > 0 && (
            <ul class="flex flex-col gap-2 border-l-2 border-border pl-4 text-point leading-relaxed text-foreground/85">
              {keyPoints.map((point) => (
                <li data-read-point class="text-pretty">
                  {point}
                </li>
              ))}
            </ul>
          )}
          {action !== "" && (
            <p class="flex items-start gap-2 rounded-lg bg-brand-soft px-3 py-2 text-sm leading-relaxed text-foreground">
              <ZapIcon className="mt-1 size-3.5 shrink-0 fill-brand text-brand-ink" aria-hidden="true" />
              <span class="text-pretty">
                <span class="font-medium text-brand-ink">Try:</span> <span data-read-action>{action}</span>
              </span>
            </p>
          )}
        </div>
      )}

      <div data-level="full" class="flex flex-col gap-4 px-(--card-spacing) pb-4">
        {listed.length > 0 && (
          <ul class="flex max-w-md flex-col gap-2" aria-label="Links in the post">
            {listed.map((link) => (
              <li>
                <LinkCard {...link} />
              </li>
            ))}
          </ul>
        )}
        {post.length > 0 && (
          <figure class="border-t border-border pt-4">
            <figcaption class="mb-2 text-xs font-medium text-muted-foreground">Original post</figcaption>
            <PostBody parts={post} className="text-sm" />
          </figure>
        )}
        {postedOtherDay && (
          <p class="text-xs text-muted-foreground tabular-nums sm:hidden">
            Posted <time datetime={isoDay(postedAt)}>{posted}</time>
          </p>
        )}
      </div>
    </div>

    <div
      data-level="points"
      class="flex flex-col gap-3 px-(--card-spacing) pb-(--card-spacing) sm:flex-row sm:justify-end"
    >
      <div class="grid grid-cols-3 gap-2 pointer-fine:grid-cols-4 sm:flex sm:items-center sm:gap-3">
        <Button
          type="button"
          variant="ghost"
          size="sm"
          data-later
          aria-label="Later"
          title="Move to the end (l)"
          className="rounded-full text-muted-foreground pointer-coarse:hidden max-sm:h-10 sm:size-7 sm:px-0"
        >
          <ClockIcon aria-hidden="true" />
        </Button>
        <Button
          type="button"
          variant="ghost"
          size="sm"
          data-copy={copyText(bookmark)}
          title="Copy for an AI assistant (c)"
          className="rounded-full max-sm:h-10"
        >
          <CopyIcon className="group-data-[copied]/button:hidden" aria-hidden="true" />
          <CheckIcon className="hidden group-data-[copied]/button:block" aria-hidden="true" />
          <span data-copy-label aria-live="polite">
            Copy
          </span>
        </Button>
        <Button
          type="button"
          variant="outline"
          size="sm"
          data-done-toggle
          aria-pressed="false"
          title="Mark done (e)"
          className="rounded-full max-sm:h-10 aria-pressed:border-done aria-pressed:bg-done aria-pressed:text-done-foreground aria-pressed:hover:bg-done/85 aria-pressed:hover:text-done-foreground dark:aria-pressed:border-done dark:aria-pressed:bg-done dark:aria-pressed:hover:bg-done/85"
        >
          <CheckIcon aria-hidden="true" />
          Done
        </Button>
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-1 rounded-sm text-sm max-sm:h-10 max-sm:rounded-full font-medium whitespace-nowrap text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-brand focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
        >
          Open on X<ArrowUpRightIcon className="size-3.5" aria-hidden="true" />
        </a>
      </div>
    </div>
  </Card>
</li>
