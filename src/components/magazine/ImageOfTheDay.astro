---
import type { ImageMetadata } from "astro";
import Block from "./Block.astro";
import IssueArt from "./IssueArt.astro";
import { langOf } from "../../lib/lang";
import type { BlockOf } from "../../lib/magazine";

type Props = {
  block: BlockOf<"image-of-the-day">;
  anchor: string;
  art: ImageMetadata;
};

const { block, anchor, art } = Astro.props;
const ART_SIZES = "(min-width: 72rem) 66rem, 100vw";
---

<Block block={block} anchor={anchor}>
  <figure lang={langOf(block.headline, block.caption)} class="flex flex-col gap-5">
    <div class="-mx-5 aspect-[3/2] overflow-hidden bg-muted sm:mx-0 sm:rounded-2xl">
      <IssueArt picture={art} alt={block.art_alt} sizes={ART_SIZES} />
    </div>
    <figcaption class="flex flex-col gap-2 border-l-4 border-brand pl-4 sm:max-w-3xl">
      <p class="font-sans text-xs font-semibold tracking-widest text-brand-ink uppercase">Image of the day</p>
      {block.headline !== undefined && (
        <h3 class="font-(family-name:--issue-heading) text-2xl leading-tight font-semibold text-balance sm:text-3xl">
          {block.headline}
        </h3>
      )}
      <p class="text-pretty text-muted-foreground">{block.caption}</p>
    </figcaption>
  </figure>
</Block>
