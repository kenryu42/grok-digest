---
import Block from "./Block.astro";
import ItemNote from "./ItemNote.astro";
import ItemTitle from "./ItemTitle.astro";
import Kicker from "./Kicker.astro";
import { postedDateLabel, refOf, type BlockOf, type FindEntry } from "../../lib/magazine";

type Props = {
  block: BlockOf<"timeline">;
  anchor: string;
  find: FindEntry;
};

const { block, anchor, find } = Astro.props;
const events = block.items
  .map((item) => ({ post: find(refOf(item)), item }))
  .toSorted((a, b) => a.post.postedAt.getTime() - b.post.postedAt.getTime());
const compact = block.variant === "compact";
---

<Block block={block} anchor={anchor} title={block.headline}>
  <ol class="flex flex-col border-l-2 border-border">
    {events.map(({ post, item }) => (
      <li
        class:list={[
          "relative flex flex-col gap-1 pl-6 before:absolute before:top-1.5 before:-left-[0.45rem] before:size-3 before:rounded-full before:bg-brand before:ring-4 before:ring-(--issue-paper)",
          compact ? "pb-4" : "pb-7",
        ]}
      >
        <time
          class="font-sans text-[0.8125rem] text-muted-foreground tabular-nums"
          datetime={post.postedAt.toISOString()}
        >
          {postedDateLabel(post.postedAt)}
        </time>
        {item.label !== undefined && <Kicker text={item.label} />}
        <ItemTitle post={post} text={post.tldr} />
        {!compact && <ItemNote item={item} />}
      </li>
    ))}
  </ol>
</Block>
