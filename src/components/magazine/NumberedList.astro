---
import Block from "./Block.astro";
import ItemTitle from "./ItemTitle.astro";
import type { BlockOf, FindBookmark } from "../../lib/magazine";

type Props = {
  block: BlockOf<"numbered-list">;
  anchor: string;
  find: FindBookmark;
};

const { block, anchor, find } = Astro.props;
const entries = block.items.map(({ bookmark, headline, note }) => {
  const found = find(bookmark);
  return { bookmark: found, headline: headline ?? found.tldr, note: note ?? found.summary };
});
const large = block.variant === "large";
---

<Block block={block} anchor={anchor} title={block.headline}>
  <ol class="flex flex-col gap-5">
    {entries.map(({ bookmark, headline, note }, index) => (
      <li class:list={["grid gap-x-4 gap-y-1", large ? "grid-cols-[2.75rem_1fr]" : "grid-cols-[1.75rem_1fr]"]}>
        <span
          aria-hidden="true"
          class:list={[
            "row-span-2 font-(family-name:--issue-heading) leading-none font-bold text-brand tabular-nums",
            large ? "text-4xl" : "text-xl",
          ]}
        >
          {index + 1}
        </span>
        <ItemTitle id={bookmark.id} text={headline} />
        <p class="text-[0.94em] text-pretty text-foreground/85">{note}</p>
      </li>
    ))}
  </ol>
</Block>
