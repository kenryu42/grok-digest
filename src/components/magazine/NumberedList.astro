---
import Block from "./Block.astro";
import ItemNote from "./ItemNote.astro";
import ItemTitle from "./ItemTitle.astro";
import { refOf, type BlockOf, type FindEntry } from "../../lib/magazine";

type Props = {
  block: BlockOf<"numbered-list">;
  anchor: string;
  find: FindEntry;
};

const { block, anchor, find } = Astro.props;
const entries = block.items.map((item) => {
  const post = find(refOf(item));
  return { post, item, headline: item.headline ?? post.tldr };
});
const large = block.variant === "large";
---

<Block block={block} anchor={anchor} title={block.headline}>
  <ol class="flex flex-col gap-5">
    {entries.map(({ post, item, headline }, index) => (
      <li class:list={["grid gap-x-4 gap-y-1", large ? "grid-cols-[2.75rem_1fr]" : "grid-cols-[1.75rem_1fr]"]}>
        <span
          aria-hidden="true"
          class:list={[
            "row-span-2 font-(family-name:--issue-heading) leading-none font-bold text-brand tabular-nums",
            large ? "text-4xl" : "text-xl",
          ]}
        >
          {index + 1}
        </span>
        <ItemTitle post={post} text={headline} />
        <ItemNote item={item} />
      </li>
    ))}
  </ol>
</Block>
