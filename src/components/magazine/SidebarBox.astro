---
import { ZapIcon } from "lucide-react";
import Block from "./Block.astro";
import type { BlockOf, FindBookmark } from "../../lib/magazine";
import { cardHref } from "../../lib/paths";

type Props = {
  block: BlockOf<"sidebar-box">;
  find: FindBookmark;
};

const { block, find } = Astro.props;
const bookmark = find(block.bookmark);
---

<Block block={block}>
  <aside class="mag-sidebar">
    <p class="mag-sidebar-title">
      <ZapIcon className="mag-sidebar-icon" aria-hidden="true" />
      {block.headline ?? "Try this"}
    </p>
    <p class="mag-sidebar-action">{bookmark.action}</p>
    <p class="mag-sidebar-source">
      From <a href={cardHref(bookmark.id)}>{bookmark.tldr}</a>
    </p>
  </aside>
</Block>
