---
import { ZapIcon } from "lucide-react";
import Block from "./Block.astro";
import { refOf, type BlockOf, type FindEntry } from "../../lib/magazine";
import { postLink } from "../../lib/paths";

type Props = {
  block: BlockOf<"sidebar-box">;
  anchor: string;
  find: FindEntry;
};

const { block, anchor, find } = Astro.props;
const post = find(refOf(block));
---

<Block block={block} anchor={anchor}>
  <aside
    class:list={[
      "flex flex-col gap-2 bg-brand-soft",
      block.variant === "callout"
        ? "rounded-r-xl border-l-[6px] border-brand p-6"
        : "max-w-xl rounded-xl p-5 ring-1 ring-brand/40",
    ]}
  >
    <p class="flex items-center gap-1.5 font-sans text-[0.8125rem] font-semibold tracking-widest text-brand-ink uppercase">
      <ZapIcon className="size-4 fill-brand text-brand-ink" aria-hidden="true" />
      {block.headline ?? "Try this"}
    </p>
    <p class="text-[1.05em] font-medium text-pretty">{post.action}</p>
    <p class="font-sans text-sm text-muted-foreground">
      From{" "}
      <a class="underline decoration-border underline-offset-4 hover:decoration-brand" {...postLink(post)}>
        “{post.tldr}”
      </a>{" "}
      by @{post.author.handle}
    </p>
  </aside>
</Block>
