---
import { Image } from "astro:assets";
import { pictureWidths, type PublishedIssue } from "../../lib/magazine";
import { issueHref } from "../../lib/paths";
import { siteConfig } from "../../lib/site-config";

type Props = {
  issue: PublishedIssue;
  sizes: string;
  eager?: boolean;
  class?: string;
};

const { issue, sizes, eager = false, class: className } = Astro.props;
const { cover, title, date } = issue;
---

<div
  data-issue-cover={issueHref(date)}
  class:list={["@container relative aspect-[3/4] overflow-hidden bg-(--issue-band) text-white", className]}
>
  {cover !== undefined && (
    <Image
      src={cover}
      alt=""
      widths={pictureWidths(cover.width)}
      sizes={sizes}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      class="absolute inset-0 size-full object-cover"
    />
  )}
  <span
    aria-hidden="true"
    class:list={[
      "absolute inset-x-0 top-0 px-[6cqi] pt-[5cqi] pb-[14cqi] font-heading text-[11cqi] leading-[0.95] font-semibold tracking-tight text-balance",
      cover !== undefined && "bg-linear-to-b from-black/55 to-transparent",
    ]}
  >
    {siteConfig.title}
  </span>
  {cover === undefined && (
    <span
      aria-hidden="true"
      class="absolute inset-x-0 bottom-0 px-[6cqi] pb-[7cqi] font-(family-name:--issue-heading) text-[9cqi] leading-[1.05] font-semibold tracking-tight text-balance"
    >
      {title}
    </span>
  )}
</div>
