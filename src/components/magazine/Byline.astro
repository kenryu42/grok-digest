---
import type { Bookmark } from "../../lib/bookmarks";
import { cardHref } from "../../lib/paths";

type Props = {
  bookmark: Bookmark;
};

const { id, url, author } = Astro.props.bookmark;
const link = "underline decoration-border underline-offset-4 transition-colors hover:decoration-brand";
---

<p class="flex flex-wrap items-baseline gap-x-2 gap-y-1 font-sans text-sm">
  <span class="font-medium">{author.name}</span>
  <span class="text-muted-foreground">@{author.handle}</span>
  <span class="ml-auto flex gap-3 font-medium text-brand-ink">
    <a class={link} href={cardHref(id)}>
      Read the card
    </a>
    <a class={link} href={url} target="_blank" rel="noopener noreferrer">
      Open on X
    </a>
  </span>
</p>
