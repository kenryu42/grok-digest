---
import Footer from "virtual:grok-digest/components/Footer.astro";
import Header from "virtual:grok-digest/components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import { siteHref } from "../../lib/paths";
import { siteConfig } from "../../lib/site-config";

type Props = {
  pageTitle: string;
  description: string;
};

const { pageTitle, description } = Astro.props;
const { title } = siteConfig;
---

<Layout
  title={`${pageTitle} · ${title}`}
  description={description}
  feedHref={siteHref("magazine/rss.xml")}
  feedTitle="Magazine"
>
  <div class="mx-auto flex min-h-dvh max-w-6xl flex-col px-safe-4 sm:px-safe-6">
    <Header title={title} swipeMode={false} nav={{ href: siteHref(""), label: "Bookmarks" }} />
    <main class="flex flex-1 flex-col gap-12 pb-16">
      <slot />
    </main>
    <Footer feed="magazine" />
  </div>
</Layout>
