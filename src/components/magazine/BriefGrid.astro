---
import Block from "./Block.astro";
import Kicker from "./Kicker.astro";
import type { BlockOf, FindBookmark } from "../../lib/magazine";
import { cardHref } from "../../lib/paths";

type Props = {
  block: BlockOf<"brief-grid">;
  find: FindBookmark;
};

const { block, find } = Astro.props;
const briefs = block.items.map(({ bookmark, headline }) => {
  const found = find(bookmark);
  return { bookmark: found, headline: headline ?? found.tldr };
});
---

<Block block={block} title={block.headline}>
  <ul class="mag-briefs" data-columns={block.columns}>
    {briefs.map(({ bookmark, headline }) => (
      <li class="mag-brief">
        <Kicker topic={bookmark.topic} />
        <h4 class="mag-item-title">
          <a href={cardHref(bookmark.id)}>{headline}</a>
        </h4>
        <p class="mag-item-text">{bookmark.summary}</p>
      </li>
    ))}
  </ul>
</Block>
