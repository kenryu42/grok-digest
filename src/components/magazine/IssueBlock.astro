---
import BriefGrid from "./BriefGrid.astro";
import Compare from "./Compare.astro";
import CoverStory from "./CoverStory.astro";
import Feature from "./Feature.astro";
import NumberedList from "./NumberedList.astro";
import PhotoSpread from "./PhotoSpread.astro";
import PullQuote from "./PullQuote.astro";
import SidebarBox from "./SidebarBox.astro";
import Timeline from "./Timeline.astro";
import TopicDivider from "./TopicDivider.astro";
import type { FindBookmark, MagazineBlock } from "../../lib/magazine";

type Props = {
  block: MagazineBlock;
  find: FindBookmark;
};

const { block, find } = Astro.props;
---

{block.type === "cover-story" && <CoverStory block={block} find={find} />}
{block.type === "feature" && <Feature block={block} find={find} />}
{block.type === "pull-quote" && <PullQuote block={block} find={find} />}
{block.type === "photo-spread" && <PhotoSpread block={block} find={find} />}
{block.type === "brief-grid" && <BriefGrid block={block} find={find} />}
{block.type === "numbered-list" && <NumberedList block={block} find={find} />}
{block.type === "compare" && <Compare block={block} find={find} />}
{block.type === "timeline" && <Timeline block={block} find={find} />}
{block.type === "topic-divider" && <TopicDivider block={block} />}
{block.type === "sidebar-box" && <SidebarBox block={block} find={find} />}
