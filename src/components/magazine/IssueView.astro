---
import IssueBlock from "./IssueBlock.astro";
import IssueCover from "./IssueCover.astro";
import {
  issueContents,
  issueDateLabel,
  themeAttributes,
  type FindEntry,
  type PublishedIssue,
} from "../../lib/magazine";
import { langOf } from "../../lib/lang";
import { siteConfig } from "../../lib/site-config";

type Props = {
  issue: PublishedIssue;
  find: FindEntry;
};

const { issue, find } = Astro.props;
const { date, number, title, subtitle, editor_note: editorNote, theme, sections } = issue;
const COVER_SIZES = "(min-width: 72rem) 26rem, (min-width: 40rem) 36vw, 15rem";
const anchorOf = (index: number): string => `s-${index + 1}`;
const groups = issueContents(sections, find, anchorOf);
const contents = groups.flatMap(({ entries }) => entries);
const numbered = new Map(contents.map(({ anchor }, index) => [anchor, index + 1]));
const linkClass = "decoration-brand underline-offset-4 hover:underline";
---

<article
  data-issue={date}
  {...themeAttributes(theme)}
  class="overflow-hidden rounded-3xl bg-(--issue-paper) font-(family-name:--issue-body) text-[1.0625rem] leading-relaxed ring-1 ring-foreground/8"
>
  <header class="grid gap-6 px-5 pt-5 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] sm:items-end sm:gap-10 sm:px-10 sm:pt-10">
    <IssueCover
      issue={issue}
      sizes={COVER_SIZES}
      eager
      class="w-full max-w-60 ring-1 ring-foreground/10 [view-transition-name:issue-cover] sm:max-w-none"
    />
    <div class="flex flex-col gap-3">
      <p class="flex flex-col gap-1 font-sans text-xs font-semibold tracking-widest uppercase">
        <span class="font-(family-name:--issue-heading) text-base tracking-[0.2em] text-brand-ink">
          {siteConfig.title} Magazine
        </span>
        <span class="text-muted-foreground">
          No. {number} · <time datetime={date}>{issueDateLabel(date)}</time>
        </span>
      </p>
      <h2
        lang={langOf(title)}
        class="font-(family-name:--issue-heading) text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-6xl"
      >
        {title}
      </h2>
      {subtitle !== undefined && (
        <p lang={langOf(subtitle)} class="max-w-3xl text-lg text-pretty text-muted-foreground sm:text-xl">
          {subtitle}
        </p>
      )}
    </div>
  </header>
  <div class="flex flex-col gap-12 px-5 py-8 sm:px-10 sm:py-10">
    {(editorNote !== undefined || contents.length > 1) && (
      <div class="grid gap-8 border-b border-border pb-10 min-[56.25rem]:grid-cols-[1.6fr_1fr]">
        {editorNote !== undefined && (
          <p
            lang={langOf(editorNote)}
            class="border-l-4 border-brand pl-4 text-pretty whitespace-pre-line text-foreground/90 italic"
          >
            {editorNote}
          </p>
        )}
        {contents.length > 1 && (
          <nav aria-labelledby={`contents-${date}`} class="flex flex-col gap-2">
            <h3
              id={`contents-${date}`}
              class="font-sans text-xs font-semibold tracking-widest text-brand-ink uppercase"
            >
              In this issue
            </h3>
            {groups.map(({ corner, entries }) => (
              <div data-contents-group class="flex flex-col gap-1.5">
                {corner !== undefined && (
                  <h4 class="mt-2 font-sans text-[0.6875rem] font-bold tracking-[0.22em] text-muted-foreground uppercase">
                    <a class={linkClass} href={`#${corner.anchor}`}>
                      {corner.heading}
                    </a>
                  </h4>
                )}
                {entries.length > 0 && (
                  <ol class="flex flex-col gap-1.5 font-sans text-sm">
                    {entries.map(({ heading, anchor }) => (
                      <li class="flex gap-3">
                        <span class="w-5 shrink-0 text-right text-muted-foreground tabular-nums">
                          {numbered.get(anchor)}
                        </span>
                        <a class={linkClass} href={`#${anchor}`} lang={langOf(heading)}>
                          {heading}
                        </a>
                      </li>
                    ))}
                  </ol>
                )}
              </div>
            ))}
          </nav>
        )}
      </div>
    )}
    <div class="grid items-start gap-12 min-[56.25rem]:grid-cols-2 min-[56.25rem]:gap-x-10">
      {sections.map((block, index) => (
        <IssueBlock block={block} anchor={anchorOf(index)} find={find} art={issue.art} />
      ))}
    </div>
  </div>
</article>
