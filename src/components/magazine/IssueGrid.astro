---
import { cardKind } from "../../lib/card-kind";
import { issueShortDateLabel, themeAttributes, type FindBookmark, type PublishedIssue } from "../../lib/magazine";
import { issueHref } from "../../lib/paths";

type Props = {
  issues: readonly PublishedIssue[];
  find: FindBookmark;
};

const { issues, find } = Astro.props;

function coverImage({ sections }: PublishedIssue) {
  const cover = sections.find((block) => block.type === "cover-story");
  if (cover === undefined) return undefined;
  const visual = cardKind(find(cover.bookmark));
  return visual.kind === "photo" ? visual.image : undefined;
}
---

<section aria-labelledby="magazine-issues" class="flex flex-col gap-6">
  <h2 id="magazine-issues" class="font-heading text-3xl font-semibold tracking-tight">
    Magazine
  </h2>
  <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {issues.map((issue) => {
      const image = coverImage(issue);
      return (
        <li {...themeAttributes(issue.theme)}>
          <a
            href={issueHref(issue.date)}
            class="group flex h-full flex-col overflow-hidden rounded-2xl bg-(--issue-paper) ring-1 ring-foreground/8 transition-shadow hover:shadow-md focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
          >
            <span class="flex flex-col gap-2 bg-(--issue-band) px-5 py-5 text-white">
              <span class="font-sans text-xs font-semibold tracking-widest text-white/80 uppercase">
                No. {issue.number} · <time datetime={issue.date}>{issueShortDateLabel(issue.date)}</time>
              </span>
              <span class="font-(family-name:--issue-heading) text-2xl leading-tight font-semibold text-balance">
                {issue.title}
              </span>
            </span>
            {image !== undefined && (
              <span data-cover class="block aspect-[16/10] overflow-hidden bg-muted">
                <img src={image.url} alt="" loading="lazy" decoding="async" class="size-full object-cover" />
              </span>
            )}
            {issue.subtitle !== undefined && (
              <span class="px-5 py-4 font-(family-name:--issue-body) text-pretty text-foreground/85">
                {issue.subtitle}
              </span>
            )}
          </a>
        </li>
      );
    })}
  </ol>
</section>
