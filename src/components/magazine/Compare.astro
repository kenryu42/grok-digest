---
import Block from "./Block.astro";
import Byline from "./Byline.astro";
import KeyPoints from "./KeyPoints.astro";
import Kicker from "./Kicker.astro";
import type { BlockOf, FindBookmark } from "../../lib/magazine";
import { cardHref } from "../../lib/paths";

type Props = {
  block: BlockOf<"compare">;
  find: FindBookmark;
};

const { block, find } = Astro.props;
const sides = block.items.map(({ bookmark, label }) => ({ bookmark: find(bookmark), label }));
---

<Block block={block} title={block.headline}>
  <div class="mag-compare">
    {sides.map(({ bookmark, label }) => (
      <article class="mag-compare-side">
        <Kicker topic={bookmark.topic} text={label} />
        <h4 class="mag-item-title">
          <a href={cardHref(bookmark.id)}>{bookmark.tldr}</a>
        </h4>
        <p class="mag-item-text">{bookmark.summary}</p>
        <KeyPoints points={bookmark.keyPoints} />
        <Byline bookmark={bookmark} />
      </article>
    ))}
  </div>
  {block.verdict !== undefined && <p class="mag-verdict">{block.verdict}</p>}
</Block>
