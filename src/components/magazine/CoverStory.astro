---
import Block from "./Block.astro";
import Byline from "./Byline.astro";
import Cover from "./Cover.astro";
import Kicker from "./Kicker.astro";
import type { BlockOf, FindBookmark } from "../../lib/magazine";
import { cardHref } from "../../lib/paths";

type Props = {
  block: BlockOf<"cover-story">;
  find: FindBookmark;
};

const { block, find } = Astro.props;
const bookmark = find(block.bookmark);
---

<Block block={block}>
  <article class="mag-cover-story">
    <Cover bookmark={bookmark} class="mag-cover-story-media" />
    <div class="mag-cover-story-text">
      <Kicker topic={bookmark.topic} text={block.kicker} />
      <h3 class="mag-display">
        <a href={cardHref(bookmark.id)}>{block.headline}</a>
      </h3>
      {block.deck !== undefined && <p class="mag-deck">{block.deck}</p>}
      <p class="mag-summary">{bookmark.summary}</p>
      <Byline bookmark={bookmark} />
    </div>
  </article>
</Block>
