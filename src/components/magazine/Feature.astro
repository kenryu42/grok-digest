---
import Block from "./Block.astro";
import Byline from "./Byline.astro";
import KeyPoints from "./KeyPoints.astro";
import Kicker from "./Kicker.astro";
import type { BlockOf, FindBookmark } from "../../lib/magazine";
import { cardHref } from "../../lib/paths";

type Props = {
  block: BlockOf<"feature">;
  find: FindBookmark;
};

const { block, find } = Astro.props;
const bookmark = find(block.bookmark);
---

<Block block={block}>
  <article class="mag-feature">
    <header class="mag-feature-head">
      <Kicker topic={bookmark.topic} />
      <h3 class="mag-headline">
        <a href={cardHref(bookmark.id)}>{block.headline ?? bookmark.tldr}</a>
      </h3>
      {block.deck !== undefined && <p class="mag-deck">{block.deck}</p>}
    </header>
    <p class="mag-summary mag-lead">{bookmark.summary}</p>
    <KeyPoints points={bookmark.keyPoints} />
    <Byline bookmark={bookmark} />
  </article>
</Block>
