---
import type { ImageMetadata } from "astro";
import Block from "./Block.astro";
import IssueArt from "./IssueArt.astro";
import Byline from "./Byline.astro";
import ItemMeta from "./ItemMeta.astro";
import Kicker from "./Kicker.astro";
import PostExpander from "./PostExpander.astro";
import { langOf } from "../../lib/lang";
import { refOf, type BlockOf, type FindEntry } from "../../lib/magazine";
import { postImages } from "../../lib/media";
import { postLink } from "../../lib/paths";

type Props = {
  block: BlockOf<"feature">;
  anchor: string;
  find: FindEntry;
  art: ImageMetadata | undefined;
};

const { block, anchor, find, art } = Astro.props;
const post = find(refOf(block));
const headline = block.headline ?? post.tldr;
const aside = block.variant === "aside";
const shownArt = postImages(post).length === 0 ? art : undefined;
const ART_SIZES = block.span === "half" ? "(min-width: 56.25rem) 32rem, 100vw" : "(min-width: 72rem) 66rem, 100vw";
---

<Block block={block} anchor={anchor}>
  <article
    lang={langOf(headline, post.summary)}
    class:list={["flex flex-col gap-4", aside && "sm:grid sm:grid-cols-[1.4fr_1fr] sm:gap-x-8"]}
  >
    {shownArt !== undefined && (
      <div class="aspect-[3/2] overflow-hidden rounded-2xl bg-muted sm:col-span-full">
        <IssueArt picture={shownArt} alt={block.art_alt} sizes={ART_SIZES} />
      </div>
    )}
    <header class="flex flex-col gap-2 sm:col-span-full">
      <Kicker topic={post.topic} />
      <h3 class="font-(family-name:--issue-heading) text-[1.75rem] leading-tight font-semibold text-balance">
        <a class="decoration-brand underline-offset-4 hover:underline" {...postLink(post)}>
          {headline}
        </a>
      </h3>
      {block.deck !== undefined && <p class="text-lg text-pretty text-muted-foreground">{block.deck}</p>}
    </header>
    <p
      class:list={[
        "text-[1.1em] text-pretty",
        block.variant === "drop-cap" &&
          "first-letter:float-left first-letter:mt-1 first-letter:mr-2 first-letter:font-(family-name:--issue-heading) first-letter:text-[3.6em] first-letter:leading-[0.8] first-letter:font-bold first-letter:text-brand-ink",
      ]}
    >
      {post.summary}
    </p>
    {post.keyPoints.length > 0 && (
      <ul
        class:list={[
          "flex list-disc flex-col gap-2 pl-5 text-[0.94em] marker:text-brand",
          aside && "rounded-xl bg-brand-soft py-4 pr-4 pl-9",
        ]}
      >
        {post.keyPoints.map((point) => (
          <li class="text-pretty">{point}</li>
        ))}
      </ul>
    )}
    <div class="flex flex-col gap-3 sm:col-span-full">
      <ItemMeta meta={block} />
      <Byline post={post} />
      <PostExpander post={post} />
    </div>
  </article>
</Block>
