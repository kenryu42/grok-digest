---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { pictureWidths } from "../../lib/magazine";

type Props = {
  picture: ImageMetadata;
  alt: string | undefined;
  sizes: string;
  class?: string;
};

const { picture, alt = "", sizes, class: className } = Astro.props;
---

<Image
  data-art
  src={picture}
  alt={alt}
  widths={pictureWidths(picture.width)}
  sizes={sizes}
  loading="lazy"
  class:list={["size-full object-cover", className]}
/>
