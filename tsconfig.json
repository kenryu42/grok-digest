{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "src", "test", "scripts", "*.ts"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "virtual:grok-digest/components/*": ["./src/components/*"]
    }
  }
}
